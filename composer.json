{
  "name": "workerman/webman",
  "type": "project",
  "keywords": [
    "high performance",
    "http service"
  ],
  "homepage": "https://www.workerman.net",
  "license": "MIT",
  "description": "High performance HTTP Service Framework.",
  "authors": [
    {
      "name": "walkor",
      "email": "walkor@workerman.net",
      "homepage": "https://www.workerman.net",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "walkor@workerman.net",
    "issues": "https://github.com/walkor/webman/issues",
    "forum": "https://wenda.workerman.net/",
    "wiki": "https://workerman.net/doc/webman",
    "source": "https://github.com/walkor/webman"
  },
  "require": {
    "php": ">=8.2",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "webman/console": "^2.1",
    "vlucas/phpdotenv": "^5.6",
    "overtrue/pinyin": "^6.0",
    "topthink/think-template": "^3.0",
    "webman/think-orm": "^2.1",
    "symfony/mailer": "^7.4",
    "nikic/php-parser": "^5.6",
    "webman/database": "2.1.7",
    "illuminate/events": "12.42.0",
    "illuminate/pagination": "12.42.0",
    "webman/captcha": "1.0.5",
    "guzzlehttp/guzzle": "7.16.1",
    "webman/event": "1.0.5",
    "intervention/image": "2.7.2",
    "symfony/yaml": "^7.4",
    "alibabacloud/oss-v2": "^0.5.0"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components",
      "plugin\\admin\\": "./app/cms/admin/legacy"
    },
    "classmap": [
      "support/SqlDebug.php"
    ]
  },
  "scripts": {
    "post-package-install": [
      "app\\cms\\support\\ComposerScripts::install"
    ],
    "post-package-update": [
      "app\\cms\\support\\ComposerScripts::install"
    ],
    "pre-package-uninstall": [
      "app\\cms\\support\\ComposerScripts::uninstall"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "conflict": {
    "webman/admin": "*"
  }
}

# ======================
# APP
# ======================
APP_DEBUG=false
# 本地排查时可显式设置 APP_DEBUG=true；生产环境保持 false。
APP_ENV=dev

TPL_CACHE=false # 是否开启模板缓存


# ======================
# Database (MySQL)
# ======================
# 默认不设置 DB_* 覆盖项：安装器会写入 config/manifest/config.yaml。
# 仅需覆盖时再显式填写；即使空值也会覆盖 YAML 配置。
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# ======================
# Optional Redis cache/session mode (private YAML redis section)
# ======================
# Redis mode loads file changes online; save in the backend to validate and enable.
# Priority: local .env > explicit process environment > selected YAML > defaults.
# CMS_REDIS_HOST=127.0.0.1
# CMS_REDIS_PORT=6379
# CMS_REDIS_USERNAME=
# CMS_REDIS_PASSWORD=
# Redis database index: 0 = first database, 1 = second, 2 = third.
# CMS_REDIS_DATABASE=0 # Redis 数据库编号：0=第一个库，1=第二个库，2=第三个库
# CMS_REDIS_TIMEOUT=0.5
# CMS_REDIS_READ_TIMEOUT=0.5
# CMS_REDIS_PREFIX=cms:

# ======================
# App Log (runtime/logs/webman-YYYY-MM-DD.log 由 RotatingFileHandler 管理)
# ======================
LOG_ENABLE=true # 是否启用默认日志
LOG_PRINT_TO_CONSOLE=true # 是否输出到终端（php://stdout）
LOG_PRINT_TO_FILE=true # 是否写入文件

# 日志文件路径（相对 runtime/）
# 1) 写目录：logs  -> 会自动变成 runtime/logs/webman.log
# 2) 写文件：logs/webman.log -> 就用这个文件名
LOG_FILE=logs/webman.log
LOG_MAX_FILES=7 # 保留天数（RotatingFileHandler 的 max_files）

# 日志等级（整数！）
# DEBUG=100 INFO=200 NOTICE=250 WARNING=300 ERROR=400 CRITICAL=500 ALERT=550 EMERGENCY=600
LOG_LEVEL=100

# ======================
# SQL Log (runtime/logs/sql-YYYY-MM-DD.log)
# ======================

# 是否启用 SQL 日志监听（Db::listen）
SQL_LOG_ENABLE=false
SQL_LOG_PRINT_TO_CONSOLE=false # 是否把 SQL 打印到终端（dump）
SQL_LOG_PRINT_TO_FILE=false # 是否写入文件

# SQL 日志目录（相对 runtime/）
# 例如 logs -> runtime/logs/sql-YYYY-MM-DD.log
SQL_LOG_FILE=logs
SQL_LOG_MAX_FILES=7 # 保留天数（当前 SqlDebug 代码里没有自动清理逻辑，但配置项存在）



# New installs: one configurable prefix; backend tables use the fixed backend_ name group.
# DB_PREFIX=wa_
# DB_TABLE_LAYOUT=unified-backend-v1
# Legacy sites without DB_TABLE_LAYOUT retain CMS_DB_PREFIX / ADMIN_DB_PREFIX.
# 网站根网址和主题由后台设置，YAML 不再需要 site 区段。
WEBMAN_WORKERS=2
WEBMAN_LISTEN=8787
